# =============================================================================
# FANZINE RUNNER · Variables de Entorno (Vercel / Desarrollo Local)
# Copiá este archivo como `.env.local` o configurá estas variables en:
# Vercel Dashboard -> Settings -> Environment Variables
# =============================================================================

# --- OPCIÓN A (RECOMENDADA): Supabase PostgreSQL + Realtime WebSockets ---
# Creá un proyecto gratis en https://supabase.com, ejecutá `supabase/schema.sql`
# en el SQL Editor y copiá las credenciales desde Project Settings -> API:
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_secret_key

# --- OPCIÓN B (ALTERNATIVA): Upstash Redis / Vercel KV ---
# Si preferís Redis atómico sin SQL (Vercel Storage -> Upstash Redis):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- SEGURIDAD Y ADMINISTRACIÓN ---
# Clave secreta HMAC para firmar tokens de sesión de partida (anti-spam/anti-cheat):
SCORE_SECRET=cambia-esta-clave-secreta-aleatoria-unlam-2026

# Clave de administrador para reiniciar el ranking vía DELETE /api/scores
# (Cabecera `x-admin-key` o `?admin_key=...`):
ADMIN_RESET_KEY=cambia-esta-clave-admin
