# =============================================================================
# FANZINE RUNNER · Variables de Entorno de Producción y Seguridad
# Copiá este archivo como `.env.local` en desarrollo local o cargá estas claves
# en: Vercel Dashboard -> Settings -> Environment Variables
# IMPORTANTE: NUNCA subas `.env` ni claves reales al repositorio Git.
# =============================================================================

# --- 1. DOMINIOS PERMITIDOS (CORS) ---
# Lista separada por comas de orígenes autorizados a consumir /api/scores:
ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# --- 2. SECRETOS CRIPTOGRÁFICOS Y ADMINISTRACIÓN (OBLIGATORIOS EN PRODUCCIÓN) ---
# Secreto aleatorio de al menos 32 caracteres para firmar tokens HMAC-SHA256 de partida
# (Podés generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SCORE_SECRET=reemplazar_con_hex_aleatorio_de_64_caracteres

# Clave privada de administrador (mín. 16 caracteres) para reiniciar el ranking vía:
# curl -X DELETE https://tudominio.com/api/scores -H "x-admin-key: TU_CLAVE"
ADMIN_RESET_KEY=reemplazar_con_clave_admin_privada_segura

# --- 3A. OPCIÓN RECOMENDADA: Supabase PostgreSQL + Realtime WebSockets ---
# Ejecutá `supabase/schema.sql` en el SQL Editor y copiá desde Project Settings -> API:
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública anónima (restringida por RLS únicamente a lectura y Realtime):
SUPABASE_ANON_KEY=tu_anon_public_key
# Clave privada service_role (SOLO en backend serverless, jamás en el frontend):
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_secret_key

# --- 3B. OPCIÓN ALTERNATIVA: Upstash Redis / Vercel KV ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- 3C. OPCIÓN ALTERNATIVA: Almacenamiento JSON Cloud Privado ---
CLOUD_STORAGE_URL=
CLOUD_STORAGE_SECURITY_KEY=
